---
import Icon from './Icon.astro';
import contact from '../data/contact.json';
---

<header class="hero">
  <div class="container inner">
    <img
      class="portrait"
      src={contact.portrait}
      alt={`Portrait of ${contact.name}`}
      width="160"
      height="160"
      fetchpriority="high"
    />
    <div class="text">
      <h1>{contact.name}</h1>
      <p class="tagline">{contact.tagline}</p>
      <p class="intro">{contact.intro}</p>
      <ul class="channels">
        {
          contact.channels.map((channel) => (
            <li>
              <a
                href={channel.href}
                title={`${channel.label}: ${channel.handle}`}
                rel={channel.href.startsWith('http') ? 'me noopener' : null}
              >
                <Icon name={channel.id as any} size={22} />
                <span class="sr-only">{channel.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 5.5rem) clamp(2.5rem, 7vw, 4rem);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  .portrait {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow);
  }

  h1 {
    font-size: clamp(2.25rem, 7vw, 3.25rem);
    font-weight: 700;
  }

  .tagline {
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    font-weight: 500;
    color: var(--text);
    margin: 0.6rem 0 0;
  }

  .intro {
    max-width: 44ch;
    margin: 1rem auto 0;
    color: var(--text-muted);
  }

  .channels {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .channels a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .channels a:hover,
  .channels a:focus-visible {
    color: var(--text);
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 46rem) {
    .inner {
      flex-direction: row;
      text-align: left;
      gap: 2.5rem;
    }

    .portrait {
      width: 200px;
      height: 200px;
      flex-shrink: 0;
    }

    .intro {
      margin-inline: 0;
    }

    .channels {
      justify-content: flex-start;
    }
  }
</style>
