---
import Icon from './Icon.astro';

interface Talk {
  id: string;
  title: string;
  event: string;
  date: string;
  dateLabel: string;
  location: string;
  eventLink: string;
  videoLink: string | null;
  image: string;
  imageAlt: string;
}

const { talk, upcoming } = Astro.props as { talk: Talk; upcoming: boolean };
---

<article class="card">
  <img
    class="cover"
    src={talk.image}
    alt={talk.imageAlt}
    width="640"
    height="360"
    loading="lazy"
    decoding="async"
  />
  <div class="body">
    {upcoming && <p class="badge">Upcoming</p>}
    <h3>{talk.title}</h3>
    <p class="meta">
      <a href={talk.eventLink} rel="noopener">{talk.event}</a>
      <span class="sep" aria-hidden="true">·</span>
      <span>{talk.dateLabel}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>{talk.location}</span>
    </p>
    {
      talk.videoLink && (
        <a class="video" href={talk.videoLink} rel="noopener">
          <Icon name="youtube" size={18} />
          <span>Watch on YouTube</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .body {
    padding: 1.25rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .badge {
    align-self: flex-start;
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, #34c759 18%, var(--bg));
    color: color-mix(in srgb, #34c759 70%, var(--accent-ink-base));
    border: 1px solid color-mix(in srgb, #34c759 35%, var(--bg));
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 650;
  }

  .meta {
    margin: 0.6rem 0 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .meta a {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .meta a:hover,
  .meta a:focus-visible {
    text-decoration: underline;
  }

  .sep {
    margin-inline: 0.35rem;
  }

  .video {
    margin-top: auto;
    padding-top: 1rem;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.45rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #e0322a;
    text-decoration: none;
  }

  .video:hover span,
  .video:focus-visible span {
    text-decoration: underline;
  }

  @media (prefers-color-scheme: dark) {
    .video {
      color: #ff6259;
    }
  }
</style>
