---
import Icon from './Icon.astro';

interface Talk {
  id: string;
  title: string;
  event: string;
  date: string;
  dateLabel: string;
  location: string;
  eventLink: string;
  videoLink: string | null;
  slidesLink: string | null;
  image: string;
  imageAlt: string;
}

const { talk, upcoming } = Astro.props as { talk: Talk; upcoming: boolean };

// The whole card is one link: to the recording when there is one, otherwise to the
// event page. When they differ, the event name stays a separate link above the overlay.
const cardHref = talk.videoLink ?? talk.eventLink;
const cardLabel = talk.videoLink
  ? `${talk.title} — watch on YouTube`
  : `${talk.title} — ${talk.event}`;
const eventIsCardTarget = !talk.videoLink;
---

<article class="card">
  <img
    class="cover"
    src={talk.image}
    alt={talk.imageAlt}
    width="640"
    height="360"
    loading="lazy"
    decoding="async"
  />
  <div class="body">
    {upcoming && <p class="badge">Upcoming</p>}
    <h3>
      <a class="stretched" href={cardHref} rel="noopener" aria-label={cardLabel}>
        {talk.title}
      </a>
    </h3>
    <p class="meta">
      {
        eventIsCardTarget ? (
          <span class="event">{talk.event}</span>
        ) : (
          <a class="event" href={talk.eventLink} rel="noopener">
            {talk.event}
          </a>
        )
      }
      <span class="sep" aria-hidden="true">·</span>
      <span>{talk.dateLabel}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>{talk.location}</span>
    </p>
    {
      (talk.videoLink || talk.slidesLink) && (
        <p class="links">
          {talk.videoLink && (
            <span class="link video">
              <Icon name="youtube" size={18} />
              <span>Watch on YouTube</span>
            </span>
          )}
          {talk.slidesLink && (
            <a
              class="link slides"
              href={talk.slidesLink}
              rel="noopener"
              aria-label={`${talk.title} — slides`}
            >
              <Icon name="slides" size={18} />
              <span>Slides</span>
            </a>
          )}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }

  /* The title's link, stretched to cover the whole card */
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card:hover .stretched {
    text-decoration: underline;
  }

  /* Move the focus ring onto the whole card — but only where :has() works, so
     browsers without it keep the default ring on the title text. */
  @supports selector(:has(*)) {
    .stretched:focus-visible {
      outline: none;
    }

    .card:has(.stretched:focus-visible) {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .body {
    padding: 1.25rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .badge {
    align-self: flex-start;
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, #34c759 18%, var(--bg));
    color: color-mix(in srgb, #34c759 70%, var(--accent-ink-base));
    border: 1px solid color-mix(in srgb, #34c759 35%, var(--bg));
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 650;
  }

  .meta {
    margin: 0.6rem 0 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .event {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  /* Raised above the stretched overlay so the event page stays reachable on cards
     whose own link points somewhere else (the recording). */
  a.event {
    position: relative;
    z-index: 2;
  }

  a.event:hover,
  a.event:focus-visible {
    text-decoration: underline;
  }

  .sep {
    margin-inline: 0.35rem;
  }

  .links {
    margin: 0;
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  /* Not a link — the whole card goes to the recording. Kept as the visible cue
     for where tapping the card leads. */
  .video {
    color: #e0322a;
  }

  /* A real link, raised above the stretched overlay so it stays reachable. */
  a.slides {
    position: relative;
    z-index: 2;
    color: var(--text-muted);
    text-decoration: none;
  }

  a.slides:hover,
  a.slides:focus-visible {
    color: var(--text);
    text-decoration: underline;
  }

  @media (prefers-color-scheme: dark) {
    .video {
      color: #ff6259;
    }
  }
</style>
