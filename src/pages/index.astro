---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AppRow from '../components/AppRow.astro';
import TalkCard from '../components/TalkCard.astro';
import ContactSheet from '../components/ContactSheet.astro';
import apps from '../data/apps.json';
import talks from '../data/talks.json';
import contact from '../data/contact.json';

// "Upcoming" is derived from the build date — it only refreshes on the next deploy.
const today = new Date().toISOString().slice(0, 10);
const isUpcoming = (talk: { date: string }) => talk.date >= today;

const sortedTalks = [...talks].sort((a, b) => {
  const upcomingA = isUpcoming(a);
  if (upcomingA !== isUpcoming(b)) return upcomingA ? -1 : 1;
  // upcoming: soonest first — past: most recent first
  return upcomingA ? a.date.localeCompare(b.date) : b.date.localeCompare(a.date);
});

// Safari's side bar (iPhone Duo, closed) is painted in the body background colour.
// While an app row covers the viewport centre, its view timeline drives a body
// animation that sets the row's tint — the same formula as in AppRow.astro.
for (const app of apps) {
  if (!/^[a-z0-9-]+$/.test(app.id)) {
    throw new Error(`apps.json: id "${app.id}" must match [a-z0-9-]+ (it is used in CSS names)`);
  }
}
const timelines = apps.map((app) => `--app-${app.id}`).join(', ');
const edgeCss = [
  ...apps.map(
    (app) =>
      `@keyframes edge-${app.id} { from, to { background-color: color-mix(in srgb, ${app.accent} var(--tint-strength), var(--bg)); } }`,
  ),
  `@supports (animation-timeline: view()) {
  body {
    timeline-scope: ${timelines};
    animation-name: ${apps.map((app) => `edge-${app.id}`).join(', ')};
    animation-timeline: ${timelines};
    animation-range: cover;
    animation-timing-function: linear;
    animation-fill-mode: none;
  }
}`,
].join('\n');
---

<Base
  title={`${contact.name} — Apps for Apple platforms`}
  description="Apps, conference talks, and contact details of Peter Kurzok, a Senior Lead Software Architect who builds apps for iPhone, iPad, and Mac in his free time."
>
  <style slot="head" is:inline set:html={edgeCss} />

  <Hero />

  <main>
    <section aria-labelledby="apps-heading">
      <h2 class="section-title container apps-heading" id="apps-heading">Apps</h2>
      {apps.map((app) => <AppRow app={app} />)}
    </section>

    <section class="talks container" aria-labelledby="talks-heading">
      <h2 class="section-title" id="talks-heading">Talks</h2>
      <div class="grid">
        {sortedTalks.map((talk) => <TalkCard talk={talk} upcoming={isUpcoming(talk)} />)}
      </div>
    </section>

    <ContactSheet />
  </main>
</Base>

<style>
  .apps-heading {
    margin-bottom: 1.25rem;
  }

  .talks {
    padding-block: clamp(3rem, 8vw, 4.5rem) 0;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
</style>
